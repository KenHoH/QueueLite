# PostgreSQL connection string, including database name and credentials.
DATABASE_URL=
# Signing key for account, guest and queue cookies. Use a long random value.
SECRET=
# Redis host:port and optional auth/TLS settings.
REDIS_HOST=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TLS=false
# Optional HTTP listen address.
HTTP_ADDR=:8080
# Set true behind HTTPS in production so auth/ticket cookies require TLS.
COOKIE_SECURE=false
# Optional trusted origin for QR code URLs (e.g. https://example.com).
PUBLIC_BASE_URL=
# Optional background worker pool and DB connection pool settings.
QUEUE_WORKER_COUNT=2
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
# Optional Telegram Bot API key for async queue notifications.
TELEBOT_API_KEY=
